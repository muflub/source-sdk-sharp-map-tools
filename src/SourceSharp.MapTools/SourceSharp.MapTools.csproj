<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <!-- Windings, portals, patches, transfers and KD nodes are structs in
         pooled or NativeMemory slabs addressed by (offset,count) handles. -->
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>

    <!--
      Packed beside SourceSharp.MapFormats (tools/pack-mapformats.sh) for one
      consumer: the game server builds a map's .nav3d in its own process when
      the map has none (LevelNavFromBsp over the bytes the engine mounts,
      NavModelBounds over its models), and restores this package from the same
      local feed at a pinned version. Its dependencies are the two libraries
      it references (MapFormats, RoomContracts, each its own package) and
      YamlDotNet; MapToolsPackageTests checks exactly that. The version rule
      is MapFormats': every drop handed over gets a new version.
    -->
    <IsPackable>true</IsPackable>
    <PackageId>SourceSharp.MapTools</PackageId>
    <Version>1.0.4</Version>
    <Authors>SourceSharp</Authors>
    <Description>SourceSharp's map compile passes as a library: the .nav3d builder over a compiled map (LevelNavFromBsp), the room pipeline, and the passes they share. CPU only; no native library on the navigation path.</Description>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>


    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <WarningsAsErrors>$(WarningsAsErrors);CS1591</WarningsAsErrors>

    <EnableNETAnalyzers>true</EnableNETAnalyzers>
    <WarningsAsErrors>$(WarningsAsErrors);CA1068;CA2016</WarningsAsErrors>
  </PropertyGroup>

  <ItemGroup>
    <!-- MapTools' project reference. The heavy runtime packages (SQLite,
         Silk.NET) live in the optional Cache.Sqlite and Gpu assemblies, which
         reference THIS one and not the reverse, so a host that wants neither a
         cache nor a GPU pulls in neither. -->
    <ProjectReference Include="..\SourceSharp.MapFormats\SourceSharp.MapFormats.csproj" />

    <!-- The mod entity contract (logic_room and the room-local naming
         grammar): its own dependency-free assembly so the Source Sharp mod can
         reference it without MapTools, and MapTools reads its constants rather
         than restating them, so the linker and the mod cannot drift apart. -->
    <ProjectReference Include="..\SourceSharp.RoomContracts\SourceSharp.RoomContracts.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- The one package MapTools takes, by the owner's decision: room levels
         are YAML files, and YAML is read with a standard library rather than a
         hand-written parser. YamlDotNet has no dependencies of its own, and the
         level reader uses only its representation model (YamlStream), which
         needs no reflection, so the NativeAOT build stays trim-clean.
         LibraryRuleTests.ReferencesNoPackages allows exactly this assembly,
         for MapTools only, and still checks what it references in turn. -->
    <PackageReference Include="YamlDotNet" Version="18.1.0" />
  </ItemGroup>
</Project>
