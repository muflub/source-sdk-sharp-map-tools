<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <!-- Windings, lump arrays and the pak writer all want spans over pooled
         memory rather than managed arrays copied twice. -->
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>

    <!--
      The one library packed as a NuGet package: the game mod reads .nav3d
      and .map2d files with this assembly's readers, and takes it as a package
      of a pinned version from a local feed (tools/pack-mapformats.sh writes
      bin/nupkg/SourceSharp.MapFormats.<Version>.nupkg), never as a project
      reference across repositories: a fresh checkout or CI of the game has
      no sibling tree, and a pinned version is what lets the game check that
      the navigation it built matches the reader it runs.

      The version rule: every drop handed to another repository gets a new
      version, even when only a fix changed. A package already handed over is
      never repacked under its old version, because a consumer's NuGet cache
      keeps the first copy it saw and goes on reading it.

      The package carries this assembly and its XML documentation and nothing
      else: the project has no PackageReference and no ProjectReference
      (below), so the package has no dependencies. A fact packs the built
      assembly and checks exactly that (MapFormatsPackageTests).
    -->
    <IsPackable>true</IsPackable>
    <PackageId>SourceSharp.MapFormats</PackageId>
    <Version>1.0.0</Version>
    <Authors>SourceSharp</Authors>
    <Description>The Source map formats as SourceSharp's map tools read and write them: BSP lumps, the .nav3d level navigation reader and writer, the .map2d level map overlay, and the map checksum both bind to. No dependencies.</Description>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>

    <!--
      A deliberate, documented public surface.

      This assembly is a LIBRARY first and a dependency of the CLI second, so
      an undocumented public member is a defect rather than a style lapse. The
      rest of the managed tree sets GenerateDocumentationFile false and has no
      such rule; these projects opt in, which is why it is set here and not in
      Directory.Build.props.
    -->
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <WarningsAsErrors>$(WarningsAsErrors);CS1591</WarningsAsErrors>

    <!--
      CA1068 (CancellationToken is the last parameter) and CA2016 (forward the
      token you were given) are errors because the async-shape rule makes the
      async shape a GATE rather than a convention: a reflection fact asserts
      every long-running public method takes a token last, and CA2016 catches
      the case that fact cannot see: a token accepted at the boundary and
      then dropped on the way in, which turns a cancellable compile into an
      uncancellable one with a correct-looking signature.

      Named individually rather than via TreatWarningsAsErrors, for the reason
      Directory.Build.props already gives at length: promoting whatever the
      current SDK's analysers happen to warn about makes a .NET update break
      this build for reasons unrelated to the code.
    -->
    <EnableNETAnalyzers>true</EnableNETAnalyzers>
    <WarningsAsErrors>$(WarningsAsErrors);CA1068;CA2016</WarningsAsErrors>
  </PropertyGroup>

  <!--
    No ItemGroup, and that is the point: MapFormats takes no PackageReference
    and no ProjectReference. Plan ruling Q3 is that the format parsers are our
    own, and a fact in SourceSharp.Tests asserts package-freedom from the BUILT
    assembly's references rather than from this file, so an indirect package
    arriving through a project reference cannot slip past by not being written
    here.
  -->
</Project>
